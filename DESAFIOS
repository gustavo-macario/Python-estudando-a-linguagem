# DESAFIO 37: O Pódio da Fórmula 1 (Foco: Ordenação com Lambda)
# Objetivo: Você tem os tempos das voltas: tempos = {'Hamilton': 62.5, 'Verstappen': 61.2, 'Leclerc': 61.8}.
# Regra: Crie ranquear_pilotos(tempos). Transforme em lista com .items() e ordene do menor para o maior tempo usando lambda.
# ==============================================================================

def ranquear_pilotos(tempos):
    lista = list(tempos.items())
    lista.sort(key=lambda x: x[1])
    return lista

tempos = {'Hamilton': 62.5, 'Verstappen': 61.2, 'Leclerc': 61.8}
print(ranquear_pilotos(tempos))


# ==============================================================================
# DESAFIO 38: Fusão de Estoques (Foco: Verificação de Chaves)
# Objetivo: Juntar o estoque da Loja A com a Loja B.
# Regra: Crie juntar_estoques(loja_a, loja_b). Se o item existir na loja_a, some; se não, crie.
# ==============================================================================

def juntar_estoques(loja_a, loja_b):
    for item, qtde in loja_b.items():
        if(item in loja_a):
            loja_a[item] += qtde
        else:
            loja_a[item] = qtde
    return loja_a

estoque_a = {'maca': 10, 'banana': 5}
estoque_b = {'banana': 10, 'uva': 8}
print(juntar_estoques(estoque_a, estoque_b))


