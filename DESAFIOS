# DESAFIO 5: Conversor de Câmbio em Lote
# Objetivo: Utilizar kwargs para converter uma quantia para várias moedas ao mesmo tempo.
def converter_moedas(valor_reais, **cotacoes):
    conversoes = {}
    for c, valor in cotacoes.items():
        resultado = valor_reais / valor
        conversoes[c] = resultado
    return conversoes

