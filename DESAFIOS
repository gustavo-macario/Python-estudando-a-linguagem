# DESAFIO 23: O Teorema de Bayes
# Objetivo: Aplicar fórmulas matemáticas precisas em funções.
# Formula: P(A|B) = (P(B|A) * P(A)) / P(B)
# ==============================================================================
def bayes(p_a, p_b_dado_a, p_b):
    pro = (p_b_dado_a * p_a) / p_b
