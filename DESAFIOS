# DESAFIO 22: O Anagrama Perfeito 
# Objetivo: Usar dicionários para otimizar comparações (sem usar listas).
# ==============================================================================
def eh_anagrama(p1, p2):
    dic1 = {}
    dic2 = {}
    
    for letra in p1:
        if(letra in dic1):
            dic1[letra] += 1
        else:      
            dic1[letra] = 1
    for letra in p2:
        if(letra in dic2):
            dic2[letra] += 1
        else:      
            dic2[letra] = 1
    return dic1 == dic2

