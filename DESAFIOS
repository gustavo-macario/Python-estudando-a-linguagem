# Objetivo: Trocar chaves e valores de lugar.
# Regra: Crie inverter_dicionario(dic). Receba algo como {'A': 1, 'B': 2} e crie um novo dicionário que seja {1: 'A', 2: 'B'}.
# ==============================================================================

def inverter_dicionario(dic):
    di2 = {}
    for c, v in dic.items():
        di2[v] = c
    return di2

dic = inverter_dicionario({'A': 1, 'B': 2})
print(dic)


