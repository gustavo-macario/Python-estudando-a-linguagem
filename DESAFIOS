# DESAFIO 39: Agrupador de Letras (Foco: Chaves Dinâmicas com Listas)
# Objetivo: Uma evolução do Anagrama.
# Regra: Crie mapear_letras(palavra). O dicionário deve guardar uma lista com a(s) posição(ões) da letra. 
# ==============================================================================

def mapear_letras(palavra):
    dic = {}
    for i, l in enumerate(palavra):
        if(l in dic):
            dic[l].append(i)
        else:
            dic[l] = [i]
    return dic

print(mapear_letras("ovo"))


