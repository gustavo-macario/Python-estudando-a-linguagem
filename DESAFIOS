# DESAFIO 9: Lógica de Caixa Eletrônico
# Objetivo: Distribuir o valor de um saque na menor quantidade de notas possíveis.
# Regras: Crie uma função sacar(valor) que recebe um número inteiro. A função deve 
# calcular e retornar um dicionário indicando quantas notas de 100, 50, 20, 10, 5 e 1 
# serão entregues. Dicionários vazios não devem aparecer no retorno final.
# ==============================================================================
def sacar(valor):
    notas = {'100': 0, '50': 0, '20': 0, '10': 0, '5': 0, '1': 0}
    
    while valor > 0:
        if valor >= 100:
            valor -= 100
            notas['100'] += 1
        elif valor >= 50:
            valor -= 50
            notas['50'] += 1
        elif valor >= 20:
            valor -= 20
            notas['20'] += 1
        elif valor >= 10:
            valor -= 10
            notas['10'] += 1
        elif valor >= 5:
            valor -= 5
            notas['5'] += 1
        else:
            valor -= 1
            notas['1'] += 1

    resultado_limpo = {}
    for nota, quantidade in notas.items():
        if quantidade > 0:
            resultado_limpo[nota] = quantidade
            
    return resultado_limpo

print(f"Saque de R$151: {sacar(151)}\n")


