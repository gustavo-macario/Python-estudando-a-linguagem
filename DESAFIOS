# DESAFIO 25: O Otimizador de Two Sum (Busca Rápida O(n))
# Objetivo: Resolver o problema em um único loop usando dicionários.
# ==============================================================================
def buscarapida(nums, alvo):
    vistos = {}

    for n in nums:
        complemento = alvo - n
        if (complemento in vistos):
            return n, complemento
        else:
            vistos[n] = True

