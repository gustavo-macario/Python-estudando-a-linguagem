# DESAFIO 32: A Liquidação (Foco: Atualização de Dicionários)
# Objetivo: Você tem estoque = {'Camiseta': 50.0, 'Tenis': 120.0}.
# Regra: Crie aplicar_desconto(produtos, desconto). Atualize o dicionário original reduzindo o preço pela porcentagem do desconto.
# ==============================================================================

def aplicar_desconto(produtos, desconto):
    for p in produtos:
        produtos[p] = produtos[p] - (desconto * produtos[p]) 
    return produtos

