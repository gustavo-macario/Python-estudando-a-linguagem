# DESAFIO 14: Calculadora de Probabilidade (kwargs)
# Objetivo: Dominar o uso de parâmetros dinâmicos e fazer contas com eles.
# ==============================================================================
def calcular_probabilidade(total, **eventos):
    pro = 0
    dic = {}
    for c, evento in eventos.items():
        pro = (evento / total) * 100
        dic[c] = pro
    return dic

