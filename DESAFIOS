# DESAFIO 40: O Caixa à Prova de Falhas 
# Objetivo: Cobrar produtos do usuário via input().
# Regra: Use um loop while True com try/except KeyError para não quebrar o programa.
# ==============================================================================

tabela_precos = {'maça': 5.5, 'banana': 3.0, 'leite': 4.2}

while True:
    try:
        p = input('Digite um produto: ').lower()
        preco = tabela_precos[p]       
        print(f'O produto {p} custa R$ {preco:.2f}')
        break  
        
    except KeyError:
        print('Produto não existe no estoque! Tente novamente.')
