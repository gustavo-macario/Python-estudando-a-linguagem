pessoas = {}
lista = []
opcao = 0
while True:
    try:
     print('Escolha sua opcao')
     print('[1] VER PESSOAS CADSATRADAS')
     print('[2] ADICIONAR NOVA PESSOA')
     print('[3] ENCERRAR PROGRAMA')
     opcao = int(input('Opcao: '))

     if(opcao == 1):
        print('-' * 30)
        print('=' * 3, 'PESSOAS CADASTRADAS', '=' * 3)
        for p in lista:
           print(f'{p["nome"]:<20} {p["idade"]:>3} anos')
        print('-' * 30)
     elif(opcao == 2):
        nome = str(input('Nome: '))
        idade = int(input('Idade: '))
        pessoas['nome'] = nome
        pessoas['idade'] = idade
        lista.append(pessoas.copy())
     elif(opcao == 3):
        print('Programa Encerrado!')
        break
    except (ValueError, TypeError) as erro:
       print(erro)
    except KeyboardInterrupt:
       print('O usuario nao digitou nada!')
    


