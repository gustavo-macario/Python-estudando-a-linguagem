# desafio 1
def leiaInt(msg):
    while True:
        try:
         n = int(input(msg)) 
        except (ValueError, TypeError):
           print('Dados invalidos.')
        except KeyboardInterrupt:
           print('O user preferiu nao digitar nada!')
           return  None
        else:
            return n


def leiaFloat(msg):
    while True:
        try:
         dado = float(input(msg).replace(',', '.'))
        except (ValueError, TypeError):
           print('Dados invalidos.')
        except KeyboardInterrupt:
           print('O user preferiu nao digitar nada!')
           return  None
        else:
           return dado

n = leiaInt('Digite seu número inteiro: ')
n2 = leiaFloat('Digite seu número decimal: ')
print(f'Você acabou de digitar o número inteiro: {n}')
print(f'Você acabou de digitar o número decimal: {n2}')


